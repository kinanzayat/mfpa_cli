{
  "name": "mfp-cli",
  "version": "1.0.0",
  "description": "Unofficial MyFitnessPal CLI for accessing your diary data, weight logs, and nutrition summaries",
  "main": "dist/index.js",
  "bin": {
    "mfp": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "npx ts-node src/cli.ts",
    "start": "node dist/cli.js",
    "test": "jest",
    "lint": "eslint src/**/*.ts"
  },
  "keywords": [
    "myfitnesspal",
    "fitness",
    "nutrition",
    "cli",
    "diet",
    "calories"
